{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true
  },
  "include": ["App.tsx", "index.ts", "src/**/*.ts", "src/**/*.tsx", "firebaseConfig.json"],
  "exclude": ["node_modules", "server"]
}
