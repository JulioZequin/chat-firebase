{
  "rules": {
    ".read": false,
    ".write": false,

    "conversations": {
      "$conversationId": {
        "members": {
          ".read": "auth != null && data.child(auth.uid).val() === true",
          "$uid": {
            ".write": "auth != null && $conversationId.beginsWith('dm_') && newData.val() === true && ($conversationId === 'dm_' + auth.uid + '_' + $uid || $conversationId === 'dm_' + $uid + '_' + auth.uid || ($uid === auth.uid && ($conversationId.beginsWith('dm_' + auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))))",
            ".validate": "newData.val() === true"
          }
        }
      }
    },

    "messages": {
      "$conversationId": {
        ".read": "auth != null && root.child('conversations/' + $conversationId + '/members/' + auth.uid).val() === true",
        ".indexOn": ["createdAt"],

        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.exists() && root.child('conversations/' + $conversationId + '/members/' + auth.uid).val() === true",
          ".validate": "newData.hasChildren(['conversationId', 'conversationType', 'senderId', 'text', 'target', 'createdAt'])",

          "conversationId": { ".validate": "newData.val() === $conversationId" },
          "conversationType": {
            ".validate": "($conversationId.beginsWith('dm_') && newData.val() === 'direct') || (!$conversationId.beginsWith('dm_') && newData.val() === 'group')"
          },
          "senderId": { ".validate": "newData.val() === auth.uid" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
          "createdAt": { ".validate": "newData.val() === now" },

          "target": {
            ".validate": "newData.child('type').val() === 'conversation' || (newData.child('type').val() === 'member' && newData.hasChild('memberId'))",
            "type": { ".validate": "newData.val() === 'conversation' || newData.val() === 'member'" },
            "memberId": {
              ".validate": "newData.isString() && root.child('conversations/' + $conversationId + '/members/' + newData.val()).val() === true"
            },
            "$other": { ".validate": false }
          },

          "mentionedUserIds": {
            "$index": {
              ".validate": "newData.isString() && root.child('conversations/' + $conversationId + '/members/' + newData.val()).val() === true"
            }
          },

          "$other": { ".validate": false }
        }
      }
    }
  }
}
