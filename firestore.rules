rules_version = '2';

// =============================================================================
// ChatFire — Security Rules do Cloud Firestore
// Firestore guarda: perfis, grupos (integrantes, limite, política de push),
// conversas individuais, tokens de dispositivos e preferências.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // URL https de imagem (bloqueia Base64/data: URI) ou vazio (sem foto).
    function validPhotoUrl(url) {
      return url is string && url.size() <= 2048 && (url == '' || url.matches('^https://.+'));
    }

    function validPolicy(policy) {
      return policy in ['all_group_messages', 'mentioned_members', 'direct_messages_only', 'disabled'];
    }

    // ---------------------------------------------------------------- users
    // Diretório público (nome + foto) — necessário para buscar usuários e iniciar conversas.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'nameLower', 'photoUrl', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.nameLower is string
        && validPhotoUrl(request.resource.data.photoUrl)
        && request.resource.data.createdAt is int;
      allow delete: if false;

      // Dados cadastrais (e-mail, celular, nascimento) e preferências de push:
      // somente o próprio usuário. Terceiros só recebem via API, se compartilharem conversa/grupo.
      match /private/profile {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['email', 'phoneNumber', 'birthDate'])
          && request.resource.data.email is string
          && request.resource.data.email.lower() == request.auth.token.email.lower()
          && request.resource.data.phoneNumber is string && request.resource.data.phoneNumber.size() <= 20
          && request.resource.data.birthDate is string && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        allow delete: if false;
      }

      match /private/preferences {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['pushEnabled', 'updatedAt'])
          && request.resource.data.pushEnabled is bool
          && request.resource.data.updatedAt is int;
        allow delete: if false;
      }

      // Tokens de dispositivos: nunca públicos.
      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['token', 'provider', 'platform', 'enabled', 'updatedAt', 'disabledReason'])
          && request.resource.data.token is string && request.resource.data.token.size() <= 512
          && request.resource.data.provider in ['fcm', 'expo']
          && request.resource.data.platform in ['ios', 'android']
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is int;
      }
    }

    // --------------------------------------------------------------- groups
    match /groups/{groupId} {
      function validGroup(d) {
        return d.keys().hasOnly(['name', 'photoUrl', 'ownerId', 'memberIds', 'memberLimit',
                                 'notificationPolicy', 'policyUpdatedBy', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['name', 'photoUrl', 'ownerId', 'memberIds', 'memberLimit',
                              'notificationPolicy', 'policyUpdatedBy', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
          && validPhotoUrl(d.photoUrl)
          && d.memberIds is list
          && d.memberLimit is int && d.memberLimit >= 2 && d.memberLimit <= 100
          // LIMITE: avaliado sobre o documento FINAL de cada escrita. Mesmo com escritas
          // concorrentes, nenhum estado salvo pode ter mais integrantes que o limite.
          && d.memberIds.size() <= d.memberLimit
          && d.memberIds.toSet().size() == d.memberIds.size()
          && d.ownerId in d.memberIds
          && validPolicy(d.notificationPolicy)
          && d.policyUpdatedBy is string
          && d.createdAt is int && d.updatedAt is int;
      }

      // Somente integrantes ativos leem o grupo.
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && validGroup(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.policyUpdatedBy == request.auth.uid
        && request.resource.data.memberIds.size() >= 2;

      allow update: if signedIn() && (
        // Proprietário: gerencia nome, foto, integrantes, limite e política.
        (
          resource.data.ownerId == request.auth.uid
          && validGroup(request.resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.memberIds.size() >= 2
        )
        ||
        // Integrante comum: só pode remover a si mesmo (sair do grupo).
        (
          request.auth.uid in resource.data.memberIds
          && request.auth.uid != resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
        )
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ------------------------------------------------- directConversations
    // Id determinístico dm_<uidMenor>_<uidMaior>: impede duplicidade e conversa consigo mesmo.
    match /directConversations/{conversationId} {
      allow get: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participantIds);
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['type', 'participantIds', 'createdAt'])
        && request.resource.data.type == 'direct'
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && conversationId == 'dm_' + request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[1]))
        && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }

    // Controle de idempotência do push — uso exclusivo da API (Admin SDK ignora as regras).
    match /notificationDispatches/{dispatchId} {
      allow read, write: if false;
    }

    // Qualquer outro caminho é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
