# Copie para .env apenas para rodar localmente. Em produção, configure estes valores
# SOMENTE nas Environment Variables do projeto na Vercel — nunca no GitHub.
PORT=3000

# Conta de serviço do Firebase (Admin SDK) — NUNCA versionar os valores reais
FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_CLIENT_EMAIL=email-da-conta-de-servico@seu-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=CONFIGURAR_APENAS_NA_HOSPEDAGEM
FIREBASE_DATABASE_URL=https://seu-project-id-default-rtdb.firebaseio.com

# Cloudinary (fotos de perfil e de grupo) — Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=CONFIGURAR_APENAS_NA_HOSPEDAGEM

# Opcional: token de acesso do Expo Push Service (se "Enhanced push security" estiver ativo no EAS)
EXPO_ACCESS_TOKEN=
